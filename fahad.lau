        task.spawn(function()
            while SPEED_ENABLED do
                if humanoid and humanoid.Parent and humanoid.Health > 0 then
                    humanoid.WalkSpeed = WALK_SPEED
                end
                task.wait(0.15)
            end
            speedLoopRunning = false
        end)
