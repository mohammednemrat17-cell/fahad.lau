tpListLayout.Padding = UDim.new(0, 5)
tpListLayout.SortOrder = Enum.SortOrder.LayoutOrder

local currentFilter = "all"
local lastSelectedButton = nil

local function refreshPlayerList()
    for _, child in ipairs(tpScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
    end
    lastSelectedButton = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local shouldShow = false
            local isFriend = false
            pcall(function() isFriend = plr:IsFriendsWith(player.UserId) end)

            if currentFilter == "all" then
                shouldShow = true
            elseif currentFilter == "friends" then
                shouldShow = isFriend
            elseif currentFilter == "strangers" then
                shouldShow = not isFriend
            end

            if shouldShow then
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, -4, 0, 42)
                row.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
                row.BorderSizePixel = 0
                row.ZIndex = 55
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
                row.Parent = tpScroll

                local nameLbl = Instance.new("TextLabel")
                nameLbl.Size = UDim2.new(1, -95, 1, 0)
                nameLbl.Position = UDim2.new(0, 12, 0, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Font = Enum.Font.Gotham
                nameLbl.Text = (isFriend and "👥 " or "❓ ") .. plr.Name
                nameLbl.TextColor3 = COLORS.Text
                nameLbl.TextSize = 13
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
                nameLbl.ZIndex = 56
                nameLbl.Parent = row

                local tpBtn = Instance.new("TextButton")
                tpBtn.Size = UDim2.new(0, 80, 0, 32)
                tpBtn.Position = UDim2.new(1, -85, 0.5, -16)
                tpBtn.BackgroundColor3 = COLORS.Red
                tpBtn.BorderSizePixel = 0
                tpBtn.Font = Enum.Font.GothamBold
                tpBtn.Text = "🎯 نقل"
                tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                tpBtn.TextSize = 13
                tpBtn.AutoButtonColor = false
                tpBtn.Active = true
                tpBtn.ZIndex = 57
                Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 6)
                tpBtn.Parent = row

                local tpStroke = Instance.new("UIStroke", tpBtn)
                tpStroke.Thickness = 1
                tpStroke.Color = Color3.fromRGB(255, 120, 120)

                local isProcessing = false
                local function doTeleport()
                    if isProcessing then return end
                    isProcessing = true
                    task.delay(0.5, function() isProcessing = false end)

                    tpBtn.BackgroundColor3 = COLORS.Green
                    tpBtn.Text = "✅ تم"
                    tpStroke.Color = Color3.fromRGB(120, 255, 120)

                    if lastSelectedButton and lastSelectedButton.Parent then
                        pcall(function()
                            lastSelectedButton.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
                        end)
                    end
                    row.BackgroundColor3 = Color3.fromRGB(30, 60, 30)
                    lastSelectedButton = row

                    pcall(function()
                        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and character and character.Parent then
                            local targetPos = plr.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
                            character:PivotTo(CFrame.new(targetPos))
                        end
                    end)

                    if updateSpectateInput then
                        pcall(updateSpectateInput, plr.Name)
                    end

                    task.delay(0.6, function()
                        if tpBtn and tpBtn.Parent then
                            tpBtn.BackgroundColor3 = COLORS.Red
                            tpBtn.Text = "🎯 نقل"
                            tpStroke.Color = Color3.fromRGB(255, 120, 120)
                        end
                    end)
                end

                tpBtn.MouseButton1Click:Connect(doTeleport)
                tpBtn.TouchTap:Connect(doTeleport)
                tpBtn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch then
                        doTeleport()
                    end
                end)

                tpBtn.MouseEnter:Connect(function()
                    TweenService:Create(tpBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(255, 80, 80)}):Play()
                end)
                tpBtn.MouseLeave:Connect(function()
                    if not isProcessing then
                        TweenService:Create(tpBtn, TweenInfo.new(0.15), {BackgroundColor3 = COLORS.Red}):Play()
                    end
                end)
            end
        end
    end
end

local function updateFilterBtns(activeBtn, otherBtn1, otherBtn2)
    activeBtn.BackgroundColor3 = COLORS.Red
    activeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    otherBtn1.BackgroundColor3 = COLORS.Card
    otherBtn1.TextColor3 = COLORS.Text
    otherBtn2.BackgroundColor3 = COLORS.Card
    otherBtn2.TextColor3 = COLORS.Text
end

local function setFilter(f, a, b, c)
    currentFilter = f
    updateFilterBtns(a, b, c)
    refreshPlayerList()
end

