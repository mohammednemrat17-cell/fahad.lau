    local text = shiftKeyInput.Text
    for _, k in ipairs(suggestedKeys) do
        if k.name:lower() == text:lower() then
            SHIFTLOCK_KEY = k.key
            SHIFTLOCK_KEY_NAME = k.name
            shiftKeyInput.Text = k.name
            shiftKeyLabel.Text = T.shiftKeyLabel .. k.name
            slKbBtn.Text = k.name
            pcall(saveSettings)
            return
        end
    end
    shiftKeyInput.Text = SHIFTLOCK_KEY_NAME
end)

