local function doFullExit()
    FULL_EXIT = true
    _G.FahadMoenLoaded = false
    pcall(function() if SHIFTLOCK_ENABLED then disableShiftLock() end end)
    pcall(function() if ESP_ENABLED then disableESP() end end)
    pcall(function() if SPEED_ENABLED then disableSpeed() end end)
    pcall(function() if JUMP_ENABLED then disableJump() end end)
    pcall(function() if INFINITE_JUMP_ENABLED then disableInfiniteJump() end end)
    pcall(function() if FLYING then setFlying(false) end end)
    pcall(function() stopSpectate() end)
    clickTPActive = false
    mobileClickTPActive = false
    task.wait(0.3)
    screenGui:Destroy()
    _G.FahadMoenLoaded = false
end

exitBtn.MouseButton1Click:Connect(doFullExit)
exitBtn.TouchTap:Connect(doFullExit)

