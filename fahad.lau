    contentFrame.Size = UDim2.new(1, -60, 1, -40)
    contentFrame.Position = UDim2.new(0, 60, 0, 40)
end

local pages = {}

local function createPage(name)
    local page = Instance.new("ScrollingFrame", contentFrame)
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = COLORS.Red
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.ZIndex = 52

    local p = Instance.new("UIPadding", page)
    p.PaddingTop = UDim.new(0, 15)
    p.PaddingLeft = UDim.new(0, 20)
    p.PaddingRight = UDim.new(0, 20)
    p.PaddingBottom = UDim.new(0, 15)

    local l = Instance.new("UIListLayout", page)
    l.Padding = UDim.new(0, 10)
    l.SortOrder = Enum.SortOrder.LayoutOrder

    pages[name] = page
    return page
end

local sidebarButtons = {}

local function createSidebarIcon(icon, pageName, order)
    local btn = Instance.new("TextButton", sidebar)
    btn.BackgroundColor3 = COLORS.IconBg
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.Text = icon
    btn.TextColor3 = COLORS.Red
    btn.TextSize = 22
    btn.AutoButtonColor = false
    btn.ZIndex = 52
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    if isMobile then
        btn.Size = UDim2.new(0, 44, 0, 44)
        btn.Position = UDim2.new(0, 10 + (order - 1) * 52, 0.5, -22)
    else
        btn.Size = UDim2.new(0, 44, 0, 44)
        btn.Position = UDim2.new(0.5, -22, 0, 10 + (order - 1) * 52)
    end

    local s = Instance.new("UIStroke", btn)
    s.Name = "SidebarStroke"
    s.Thickness = 1
    s.Color = Color3.fromRGB(45, 45, 52)

    table.insert(sidebarButtons, {button = btn, pageName = pageName})
    return btn
end

local function showPage(pageName)
    for name, page in pairs(pages) do
        page.Visible = (name == pageName)
    end
    for _, item in ipairs(sidebarButtons) do
        local btn = item.button
        local stroke = btn:FindFirstChild("SidebarStroke")
        if item.pageName == pageName then
            btn.BackgroundColor3 = Color3.fromRGB(80, 30, 35)
            btn.TextColor3 = Color3.fromRGB(255, 120, 120)
            if stroke then
                stroke.Color = COLORS.Red
                stroke.Thickness = 2
            end
        else
            btn.BackgroundColor3 = COLORS.IconBg
            btn.TextColor3 = COLORS.Red
            if stroke then
                stroke.Color = Color3.fromRGB(45, 45, 52)
                stroke.Thickness = 1
            end
        end
    end
end

createPage("Home")
createPage("Players")
createPage("Features")
createPage("Settings")

createSidebarIcon("🎯", "Home", 1)
createSidebarIcon("👥", "Players", 2)
createSidebarIcon("💀", "Features", 3)
createSidebarIcon("⚙", "Settings", 4)

