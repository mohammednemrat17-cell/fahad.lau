local jumpSlider = Instance.new("Frame", settingsPage)
jumpSlider.Size = UDim2.new(1, 0, 0, 8)
jumpSlider.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
jumpSlider.BorderSizePixel = 0
jumpSlider.ZIndex = 53
Instance.new("UICorner", jumpSlider).CornerRadius = UDim.new(0, 4)

local jumpBar = Instance.new("Frame", jumpSlider)
jumpBar.Size = UDim2.new(math.clamp((JUMP_POWER - 10) / 490, 0, 1), 0, 1, 0)
jumpBar.BackgroundColor3 = COLORS.Yellow
jumpBar.BorderSizePixel = 0
jumpBar.ZIndex = 54
Instance.new("UICorner", jumpBar).CornerRadius = UDim.new(0, 4)

local jumpHandle = Instance.new("TextButton", jumpSlider)
jumpHandle.Size = UDim2.new(0, 18, 0, 18)
jumpHandle.Position = UDim2.new(math.clamp((JUMP_POWER - 10) / 490, 0, 1), -9, 0.5, -9)
jumpHandle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
jumpHandle.Text = ""
jumpHandle.ZIndex = 55
Instance.new("UICorner", jumpHandle).CornerRadius = UDim.new(1, 0)

local isDraggingJump = false
jumpHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingJump = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isDraggingJump then pcall(saveSettings) end
        isDraggingJump = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if isDraggingJump and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local w = jumpSlider.AbsoluteSize.X
        if w <= 0 then return end
        local newX = math.clamp(input.Position.X - jumpSlider.AbsolutePosition.X, 0, w)
        local p = newX / w
        JUMP_POWER = 10 + math.floor(p * 490)
        jumpPowerLabel.Text = T.jumpPowerLabel .. tostring(JUMP_POWER)
        jumpBar.Size = UDim2.new(p, 0, 1, 0)
        jumpHandle.Position = UDim2.new(p, -9, 0.5, -9)
        if JUMP_ENABLED then applyJump() end
    end
end)

