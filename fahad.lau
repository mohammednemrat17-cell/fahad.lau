local function refreshPickerList(filter)
    for _, child in ipairs(pickerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    filter = filter and filter:lower() or ""
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            if filter == "" or plr.Name:lower():sub(1, #filter) == filter then
                count = count + 1
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -4, 0, 36)
                btn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
                btn.Font = Enum.Font.GothamBold
                btn.Text = plr.Name
                btn.TextColor3 = COLORS.Text
                btn.TextSize = 13
                btn.AutoButtonColor = false
                btn.Active = true
                btn.ZIndex = 502
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
                btn.Parent = pickerScroll

                local function pick()
                    if updateSpectateInput then pcall(updateSpectateInput, plr.Name) end
                    pickerFrame.Visible = false
                    pickerOverlay.Visible = false
                end

                btn.MouseButton1Click:Connect(pick)
                btn.TouchTap:Connect(pick)
            end
        end
    end
    if count == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -4, 0, 36)
        empty.BackgroundTransparency = 1
        empty.Font = Enum.Font.Gotham
        empty.Text = T.noPlayers
        empty.TextColor3 = COLORS.TextDim
        empty.TextSize = 13
        empty.ZIndex = 502
        empty.Parent = pickerScroll
    end
end

searchInput:GetPropertyChangedSignal("Text"):Connect(function()
    refreshPickerList(searchInput.Text)
end)

local function openPicker()
    pickerFrame.Visible = true
    pickerOverlay.Visible = true
    searchInput.Text = ""
    refreshPickerList("")
end

local function closePicker()
    pickerFrame.Visible = false
    pickerOverlay.Visible = false
end

