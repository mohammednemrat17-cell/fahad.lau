--// ==================== createToggleButton ====================
local function createToggleButton(parent, icon, labelKey, featureName, callback)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 55)
    btn.BackgroundColor3 = COLORS.Card
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Active = true
    btn.ZIndex = 53
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    btn:SetAttribute("IsActive", false)

    local nameLabel = Instance.new("TextLabel", btn)
    nameLabel.Size = UDim2.new(0.45, 0, 1, 0)
    nameLabel.Position = UDim2.new(0, 15, 0, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Text = icon .. "  " .. T[labelKey]
    nameLabel.TextColor3 = COLORS.Text
    nameLabel.TextSize = 15
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
    nameLabel.ZIndex = 54
    registerText(nameLabel, labelKey, icon .. "  ")

    local kbBtn = Instance.new("TextButton", btn)
    kbBtn.Size = UDim2.new(0, 38, 0, 24)
    kbBtn.Position = UDim2.new(1, -160, 0.5, -12)
    kbBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    kbBtn.Font = Enum.Font.GothamBold
    kbBtn.Text = KEYBINDS[featureName] and KEYBINDS[featureName].name or "?"
    kbBtn.TextColor3 = COLORS.Yellow
    kbBtn.TextSize = 12
    kbBtn.AutoButtonColor = false
    kbBtn.ZIndex = 55
    Instance.new("UICorner", kbBtn).CornerRadius = UDim.new(0, 6)

    local toggleBg = Instance.new("Frame", btn)
    toggleBg.Size = UDim2.new(0, 54, 0, 28)
    toggleBg.Position = UDim2.new(1, -70, 0.5, -14)
    toggleBg.BackgroundColor3 = COLORS.ToggleOff
    toggleBg.BorderSizePixel = 0
    toggleBg.ZIndex = 54
    Instance.new("UICorner", toggleBg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", toggleBg)
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.Position = UDim2.new(0, 3, 0.5, -11)
    knob.BackgroundColor3 = COLORS.ToggleKnob
    knob.BorderSizePixel = 0
    knob.ZIndex = 55
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function updateToggle(isOn)
        if isOn then
            TweenService:Create(toggleBg, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.ToggleOn}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -25, 0.5, -11)}):Play()
            btn:SetAttribute("IsActive", true)
            btn.BackgroundColor3 = Color3.fromRGB(45, 25, 28)
        else
            TweenService:Create(toggleBg, TweenInfo.new(0.2), {BackgroundColor3 = COLORS.ToggleOff}):Play()
            TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -11)}):Play()
            btn:SetAttribute("IsActive", false)
            btn.BackgroundColor3 = COLORS.Card
        end
    end

    local function onToggle()
        pcall(callback, updateToggle)
    end

    btn.MouseButton1Click:Connect(onToggle)
    btn.TouchTap:Connect(onToggle)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            onToggle()
        end
    end)

    TOGGLE_CALLBACKS[featureName] = onToggle

    return btn, updateToggle
end

