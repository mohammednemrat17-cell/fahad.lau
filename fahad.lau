local T = TRANSLATIONS[LANG]

local TEXT_UPDATERS = {}
local function registerText(obj, key, prefix, suffix)
    table.insert(TEXT_UPDATERS, {obj = obj, key = key, prefix = prefix or "", suffix = suffix or ""})
end

local function applyLanguage()
    T = TRANSLATIONS[LANG]
    for _, item in ipairs(TEXT_UPDATERS) do
        if item.obj and item.obj.Parent then
            pcall(function()
                item.obj.Text = item.prefix .. (T[item.key] or item.key) .. item.suffix
            end)
        end
    end
end

local function setLanguage(lang)
    LANG = lang
    applyLanguage()
    pcall(saveSettings)
end

--// ==================== ⌨️ KEYBIND HELPERS ====================
local TOGGLE_CALLBACKS = {}
local KEYBIND_LABELS = {}

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    for name, data in pairs(KEYBINDS) do
        if input.KeyCode == data.key then
            if TOGGLE_CALLBACKS[name] then
                pcall(TOGGLE_CALLBACKS[name])
            end
            break
        end
    end
end)

