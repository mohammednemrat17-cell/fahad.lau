    local adminBtn = Instance.new("TextButton")
    adminBtn.Name = "AdminToggleBtn"
    adminBtn.Size = UDim2.new(0, 50, 0, 50)
    adminBtn.Position = UDim2.new(1, -70, 0, 130)
    adminBtn.BackgroundColor3 = Color3.fromRGB(40, 20, 60)
    adminBtn.BorderSizePixel = 0
    adminBtn.Font = Enum.Font.GothamBold
    adminBtn.Text = "🎮"
    adminBtn.TextColor3 = Color3.fromRGB(200, 100, 255)
    adminBtn.TextSize = 22
    adminBtn.AutoButtonColor = false
    adminBtn.Active = true
    adminBtn.ZIndex = 250
    adminBtn.Parent = screenGui
    Instance.new("UICorner", adminBtn).CornerRadius = UDim.new(1, 0)

    local adminStroke = Instance.new("UIStroke", adminBtn)
    adminStroke.Thickness = 2
    adminStroke.Color = Color3.fromRGB(200, 100, 255)

    local adminVisible = true
    local function toggleAdmin()
        adminVisible = not adminVisible
        local count = 0
        pcall(function()
            for _, gui in ipairs(player.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui ~= screenGui and gui.Name ~= "FahadMoenCountdown" then
                    local lowerName = gui.Name:lower()
                    if lowerName:find("yield") or lowerName:find("mickey") or lowerName:find("admin") or lowerName:find("iy") then
                        for _, obj in ipairs(gui:GetChildren()) do
                            if obj:IsA("GuiObject") then
                                obj.Visible = adminVisible
                                count = count + 1
                            end
                        end
                    end
                end
            end
        end)
        adminBtn.Text = adminVisible and "🎮" or "❌"
    end

    adminBtn.MouseButton1Click:Connect(toggleAdmin)
    adminBtn.TouchTap:Connect(toggleAdmin)
    adminBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            toggleAdmin()
        end
    end)
end)

