--// ==================== 📐 RESPONSIVE HELPERS ====================
local function getViewport()
    local cam = workspace.CurrentCamera
    if cam then return cam.ViewportSize end
    return Vector2.new(1280, 720)
end

local function getResponsiveSize()
    local vp = getViewport()
    local maxW, maxH
    if vp.X < 700 then
        maxW = vp.X * 0.95
        maxH = vp.Y * 0.80
    elseif vp.X < 1100 then
        maxW = math.min(620, vp.X * 0.85)
        maxH = math.min(440, vp.Y * 0.82)
    else
        maxW = math.min(700, vp.X * 0.7)
        maxH = math.min(460, vp.Y * 0.8)
    end
    return UDim2.new(0, math.floor(maxW), 0, math.floor(maxH))
end

local function getResponsivePosition()
    local vp = getViewport()
    local w = getResponsiveSize().X.Offset
    if vp.X < 700 then
        return UDim2.new(1, -w - 10, 0, 10)
    else
        return UDim2.new(1, -w - 15, 0, 15)
    end
end

local isMobile = getViewport().X < 700

--// ==================== ⏱️ COUNTDOWN ====================
local function runCountdown(seconds, callback)
    seconds = seconds or 10

    local countdownGui = Instance.new("ScreenGui")
    countdownGui.Name = "FahadMoenCountdown"
    countdownGui.Parent = player:WaitForChild("PlayerGui")
    countdownGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    countdownGui.ResetOnSpawn = false
    countdownGui.IgnoreGuiInset = true
    countdownGui.DisplayOrder = 1000

    local bg = Instance.new("Frame", countdownGui)
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 1
    bg.BorderSizePixel = 0
    bg.ZIndex = 1

    TweenService:Create(bg, TweenInfo.new(0.4), {BackgroundTransparency = 0.45}):Play()

    local mainFrame = Instance.new("Frame", countdownGui)
    mainFrame.Size = UDim2.new(0, 340, 0, 160)
    mainFrame.Position = UDim2.new(0.5, -170, 0, -200)
    mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    mainFrame.BackgroundTransparency = 0.05
    mainFrame.BorderSizePixel = 0
    mainFrame.ZIndex = 2
    Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 16)

    local mainStroke = Instance.new("UIStroke", mainFrame)
    mainStroke.Thickness = 2
    mainStroke.Color = Color3.fromRGB(220, 60, 60)

    local iconLabel = Instance.new("TextLabel", mainFrame)
    iconLabel.Size = UDim2.new(1, 0, 0, 30)
    iconLabel.Position = UDim2.new(0, 0, 0, 8)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.Text = "🎯 fahad_moen"
    iconLabel.TextColor3 = Color3.fromRGB(220, 60, 60)
    iconLabel.TextSize = 16
    iconLabel.ZIndex = 3

    local numberLabel = Instance.new("TextLabel", mainFrame)
    numberLabel.Size = UDim2.new(1, 0, 0, 80)
    numberLabel.Position = UDim2.new(0, 0, 0, 38)
    numberLabel.BackgroundTransparency = 1
    numberLabel.Font = Enum.Font.GothamBold
    numberLabel.Text = tostring(seconds)
    numberLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    numberLabel.TextSize = 64
    numberLabel.ZIndex = 3

    local subLabel = Instance.new("TextLabel", mainFrame)
    subLabel.Size = UDim2.new(1, 0, 0, 25)
    subLabel.Position = UDim2.new(0, 0, 1, -30)
    subLabel.BackgroundTransparency = 1
    subLabel.Font = Enum.Font.GothamBold
    subLabel.Text = T.loading
    subLabel.TextColor3 = Color3.fromRGB(220, 60, 60)
    subLabel.TextSize = 14
    subLabel.ZIndex = 3

    local progressBg = Instance.new("Frame", mainFrame)
    progressBg.Size = UDim2.new(0.9, 0, 0, 5)
    progressBg.Position = UDim2.new(0.05, 0, 1, -10)
    progressBg.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    progressBg.BorderSizePixel = 0
    progressBg.ZIndex = 3
    Instance.new("UICorner", progressBg).CornerRadius = UDim.new(1, 0)

    local progressBar = Instance.new("Frame", progressBg)
    progressBar.Size = UDim2.new(0, 0, 1, 0)
    progressBar.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    progressBar.BorderSizePixel = 0
    progressBar.ZIndex = 4
    Instance.new("UICorner", progressBar).CornerRadius = UDim.new(1, 0)

    TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -170, 0.5, -80)
    }):Play()

    for i = seconds, 0, -1 do
        numberLabel.Text = tostring(i)
        numberLabel.TextSize = 64
        TweenService:Create(numberLabel, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            TextSize = 86
        }):Play()

        local currentColor
        if i <= 3 then
            currentColor = Color3.fromRGB(255, 40, 40)
        elseif i <= 6 then
            currentColor = Color3.fromRGB(255, 200, 60)
        else
            currentColor = Color3.fromRGB(60, 220, 60)
        end

        TweenService:Create(numberLabel, TweenInfo.new(0.2), {TextColor3 = currentColor}):Play()
        TweenService:Create(mainStroke, TweenInfo.new(0.2), {Color = currentColor}):Play()
        TweenService:Create(progressBar, TweenInfo.new(0.2), {BackgroundColor3 = currentColor}):Play()

        local progress = (seconds - i + 1) / (seconds + 1)
        TweenService:Create(progressBar, TweenInfo.new(0.9, Enum.EasingStyle.Linear), {
            Size = UDim2.new(progress, 0, 1, 0)
        }):Play()

        task.wait(1)
    end

    numberLabel.Text = "GO!"
    numberLabel.TextColor3 = Color3.fromRGB(60, 220, 60)
    mainStroke.Color = Color3.fromRGB(60, 220, 60)
    subLabel.Text = T.ready
    subLabel.TextColor3 = Color3.fromRGB(60, 220, 60)

    task.wait(1.2)
    countdownGui:Destroy()

    if callback then pcall(callback) end
end

