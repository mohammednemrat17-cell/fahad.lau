local function bindSidebar(idx, pageName)
    local btn = sidebarButtons[idx].button
    btn.MouseButton1Click:Connect(function() showPage(pageName) end)
    btn.TouchTap:Connect(function() showPage(pageName) end)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            showPage(pageName)
        end
    end)
end

bindSidebar(1, "Home")
bindSidebar(2, "Players")
bindSidebar(3, "Features")
bindSidebar(4, "Settings")

showPage("Home")

local function onClose()
    if SHIFTLOCK_ENABLED then
        disableShiftLock()
        updateShiftLockToggle(false)
    end
    if FULL_EXIT then return end
    hubFrame.Visible = false
    floatingBtn.Visible = true
end

closeBtn.MouseButton1Click:Connect(onClose)
closeBtn.TouchTap:Connect(onClose)

local isMinimized = false
local function onMinimize()
    isMinimized = not isMinimized
    local fullSize = getResponsiveSize()
    local targetSize = isMinimized and UDim2.new(fullSize.X.Scale, fullSize.X.Offset, 0, 40) or fullSize
    TweenService:Create(hubFrame, TweenInfo.new(0.2), {Size = targetSize}):Play()
end

