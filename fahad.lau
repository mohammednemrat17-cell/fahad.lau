--// SPECTATE
local function findPlayerByName(name)
    if not name or name == "" then return nil end
    name = name:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Name:lower():sub(1, #name) == name then
            return plr
        end
    end
    return nil
end

local function stopSpectate()
    SPECTATED_PLAYER = nil
    if spectateConnection then spectateConnection:Disconnect(); spectateConnection = nil end
    local camera = workspace.CurrentCamera
    if character and character:FindFirstChildOfClass("Humanoid") then
        camera.CameraSubject = character:FindFirstChildOfClass("Humanoid")
    elseif originalCameraSubject then
        camera.CameraSubject = originalCameraSubject
    end
end

local function startSpectate(plr)
    if not plr or not plr.Character then return end
    SPECTATED_PLAYER = plr
    local camera = workspace.CurrentCamera
    originalCameraSubject = camera.CameraSubject
    spectateConnection = RunService.RenderStepped:Connect(function()
        if not SPECTATED_PLAYER or not SPECTATED_PLAYER.Character then
            stopSpectate()
            return
        end
        local th = SPECTATED_PLAYER.Character:FindFirstChildOfClass("Humanoid")
        if th then
            camera.CameraSubject = th
            camera.CameraType = Enum.CameraType.Custom
        end
    end)
end

specBtn.MouseButton1Click:Connect(function()
    local plr = findPlayerByName(specInput.Text)
    if plr then
        startSpectate(plr)
        specBtn.Text = T.spectating
        specBtn.BackgroundColor3 = COLORS.Green
        task.wait(1)
        specBtn.Text = T.spectate
        specBtn.BackgroundColor3 = COLORS.Cyan
    else
        specBtn.Text = T.notFound
        specBtn.BackgroundColor3 = COLORS.Red
        task.wait(1)
        specBtn.Text = T.spectate
        specBtn.BackgroundColor3 = COLORS.Cyan
    end
end)

stopSpecBtn.MouseButton1Click:Connect(function()
    stopSpectate()
    stopSpecBtn.Text = T.stopped
    stopSpecBtn.BackgroundColor3 = COLORS.Green
    task.wait(1)
    stopSpecBtn.Text = T.stopSpectate
    stopSpecBtn.BackgroundColor3 = COLORS.Card
end)

