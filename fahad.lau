refreshKeyPicker = function()
    for _, child in ipairs(keyPickerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, k in ipairs(suggestedKeys) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -4, 0, 36)
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
        btn.Font = Enum.Font.GothamBold
        btn.Text = k.name
        btn.TextColor3 = COLORS.Text
        btn.TextSize = 14
        btn.AutoButtonColor = false
        btn.Active = true
        btn.ZIndex = 602
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.Parent = keyPickerScroll

        if k.name == SHIFTLOCK_KEY_NAME then
            btn.BackgroundColor3 = COLORS.Orange
            btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        end

        local function pick()
            SHIFTLOCK_KEY = k.key
            SHIFTLOCK_KEY_NAME = k.name
            shiftKeyInput.Text = k.name
            shiftKeyLabel.Text = T.shiftKeyLabel .. k.name
            slKbBtn.Text = k.name
            keyPickerFrame.Visible = false
            keyPickerOverlay.Visible = false
            pcall(saveSettings)
        end

        btn.MouseButton1Click:Connect(pick)
        btn.TouchTap:Connect(pick)
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                pick()
            end
        end)
    end
end

local function openShiftKeyPicker()
    refreshKeyPicker()
    keyPickerFrame.Visible = true
    keyPickerOverlay.Visible = true
end

