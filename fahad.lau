--// ==================== 💾 SAVE SYSTEM ====================
local SAVE_FILE = "FahadMoen_Settings.json"
local SAVE_FOLDER = "FahadMoen"

local KEY_NAME_TO_CODE = {
    RightShift = Enum.KeyCode.RightShift, LeftShift = Enum.KeyCode.LeftShift,
    RightAlt = Enum.KeyCode.RightAlt, LeftAlt = Enum.KeyCode.LeftAlt,
    RightControl = Enum.KeyCode.RightControl, LeftControl = Enum.KeyCode.LeftControl,
    CapsLock = Enum.KeyCode.CapsLock, Tab = Enum.KeyCode.Tab,
    Q = Enum.KeyCode.Q, E = Enum.KeyCode.E, R = Enum.KeyCode.R,
    T = Enum.KeyCode.T, F = Enum.KeyCode.F, G = Enum.KeyCode.G,
    H = Enum.KeyCode.H, V = Enum.KeyCode.V, C = Enum.KeyCode.C,
    X = Enum.KeyCode.X, Z = Enum.KeyCode.Z, B = Enum.KeyCode.B,
    N = Enum.KeyCode.N, M = Enum.KeyCode.M, P = Enum.KeyCode.P,
    J = Enum.KeyCode.J, K = Enum.KeyCode.K, L = Enum.KeyCode.L,
    I = Enum.KeyCode.I,
}

local LANG = "ar"
local flySpeed = 1
local WALK_SPEED = 100
local JUMP_POWER = 50
local SHIFTLOCK_KEY = Enum.KeyCode.RightShift
local SHIFTLOCK_KEY_NAME = "RightShift"

local KEYBINDS = {
    Fly          = {key = Enum.KeyCode.F, name = "F"},
    ClickTP      = {key = Enum.KeyCode.T, name = "T"},
    JumpPower    = {key = Enum.KeyCode.J, name = "J"},
    ESP          = {key = Enum.KeyCode.E, name = "E"},
    Speed        = {key = Enum.KeyCode.V, name = "V"},
    InfiniteJump = {key = Enum.KeyCode.I, name = "I"},
}

local function getSavePath()
    if writefile and isfolder and makefolder then
        pcall(function()
            if not isfolder(SAVE_FOLDER) then
                makefolder(SAVE_FOLDER)
            end
        end)
        return SAVE_FOLDER .. "/" .. SAVE_FILE
    end
    return nil
end

local function saveSettings()
    local path = getSavePath()
    if not path then return end
    local data = {
        LANG = LANG,
        SHIFTLOCK_KEY_NAME = SHIFTLOCK_KEY_NAME,
        WALK_SPEED = WALK_SPEED,
        JUMP_POWER = JUMP_POWER,
        flySpeed = flySpeed,
        KEYBINDS = {},
    }
    for name, kb in pairs(KEYBINDS) do
        data.KEYBINDS[name] = kb.name
    end
    local success, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if success and encoded then
        pcall(function() writefile(path, encoded) end)
    end
end

local function loadSettings()
    local path = getSavePath()
    if not path then return end
    if not (isfile and isfile(path)) then return end
    local success, content = pcall(function() return readfile(path) end)
    if not success or not content or content == "" then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok or type(data) ~= "table" then return end
    if data.LANG and (data.LANG == "ar" or data.LANG == "en") then LANG = data.LANG end
    if data.SHIFTLOCK_KEY_NAME and KEY_NAME_TO_CODE[data.SHIFTLOCK_KEY_NAME] then
        SHIFTLOCK_KEY_NAME = data.SHIFTLOCK_KEY_NAME
        SHIFTLOCK_KEY = KEY_NAME_TO_CODE[data.SHIFTLOCK_KEY_NAME]
    end
    if data.WALK_SPEED and type(data.WALK_SPEED) == "number" then WALK_SPEED = data.WALK_SPEED end
    if data.JUMP_POWER and type(data.JUMP_POWER) == "number" then JUMP_POWER = data.JUMP_POWER end
    if data.flySpeed and type(data.flySpeed) == "number" then flySpeed = data.flySpeed end
    if data.KEYBINDS then
        for name, keyName in pairs(data.KEYBINDS) do
            if KEYBINDS[name] and KEY_NAME_TO_CODE[keyName] then
                KEYBINDS[name].key = KEY_NAME_TO_CODE[keyName]
                KEYBINDS[name].name = keyName
            end
        end
    end
end

pcall(loadSettings)

task.spawn(function()
    while true do
        task.wait(5)
        pcall(saveSettings)
    end
end)

