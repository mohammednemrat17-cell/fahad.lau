--// MOVEMENT
local keyMap = {[Enum.KeyCode.W]="F",[Enum.KeyCode.S]="B",[Enum.KeyCode.A]="L",[Enum.KeyCode.D]="R",[Enum.KeyCode.Q]="Q",[Enum.KeyCode.Space]="E"}
local valueMap = {[Enum.KeyCode.W]=1,[Enum.KeyCode.S]=-1,[Enum.KeyCode.A]=-1,[Enum.KeyCode.D]=1,[Enum.KeyCode.Q]=-1,[Enum.KeyCode.Space]=1}
UserInputService.InputBegan:Connect(function(input, gpe) if gpe or not keyMap[input.KeyCode] then return end CONTROL[keyMap[input.KeyCode]] = valueMap[input.KeyCode] end)
UserInputService.InputEnded:Connect(function(input) if keyMap[input.KeyCode] then CONTROL[keyMap[input.KeyCode]] = 0 end end)

--// CLICK TP (Desktop)
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if clickTPActive and input.UserInputType == Enum.UserInputType.MouseButton1 then
        local mousePos = UserInputService:GetMouseLocation()
        local guiObjects = player.PlayerGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
        local isOverHub = false
        for _, obj in ipairs(guiObjects) do
            if obj:IsDescendantOf(screenGui) then isOverHub = true break end
        end

        if not isOverHub and rootPart and character then
            local camera = workspace.CurrentCamera
            local mouseLocation = UserInputService:GetMouseLocation()
            local unitRay = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y)

            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {character}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude

            local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 5000, raycastParams)
            if not result then return end

            local targetPos = result.Position + Vector3.new(0, 3, 0)
            local cameraLook = camera.CFrame.LookVector
            local flatLook = Vector3.new(cameraLook.X, 0, cameraLook.Z)
            local lookAtPos = targetPos + flatLook

            local newCFrame = CFrame.lookAt(targetPos, lookAtPos)
            pcall(function() character:PivotTo(newCFrame) end)
        end
    end
end)

--// SHIFT LOCK KEYBIND
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == SHIFTLOCK_KEY then
        if SHIFTLOCK_ENABLED then
            disableShiftLock()
            updateShiftLockToggle(false)
        else
            enableShiftLock()
            updateShiftLockToggle(true)
        end
    end
end)

--// Emergency mouse release (M)
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.M then
        pcall(function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end)
    end
end)

--// HIDE GUI (K)
local guiHidden = false
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.K then
        guiHidden = not guiHidden
        hubFrame.Visible = not guiHidden
        if guiHidden then
            floatingBtn.Visible = true
        else
            floatingBtn.Visible = false
        end
    end
end)

--// RESPAWN
player.CharacterAdded:Connect(function(newChar)
    if CFloop then CFloop:Disconnect(); CFloop = nil end
    FLYING = false
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    rootPart = newChar:WaitForChild("HumanoidRootPart")
    task.wait(0.5)
    if isFlyToggledOn then setFlying(true) end
    if SPEED_ENABLED then applySpeed() end
    if JUMP_ENABLED then applyJump() end
end)

--// ==================== RESPONSIVE UPDATER ====================
local function updateResponsiveLayout()
    local vp = getViewport()
    local mobile = vp.X < 700

    if hubFrame and hubFrame.Parent then
        hubFrame.Size = getResponsiveSize()
        hubFrame.Position = getResponsivePosition()
    end
    if sidebar and sidebar.Parent then
        if mobile then
            sidebar.Size = UDim2.new(1, 0, 0, 50)
            sidebar.Position = UDim2.new(0, 0, 1, -50)
        else
            sidebar.Size = UDim2.new(0, 60, 1, -40)
            sidebar.Position = UDim2.new(0, 0, 0, 40)
        end
    end
    if contentFrame and contentFrame.Parent then
        if mobile then
            contentFrame.Size = UDim2.new(1, 0, 1, -90)
            contentFrame.Position = UDim2.new(0, 0, 0, 40)
        else
            contentFrame.Size = UDim2.new(1, -60, 1, -40)
            contentFrame.Position = UDim2.new(0, 60, 0, 40)
        end
    end
    for i, item in ipairs(sidebarButtons) do
        local btn = item.button
        if btn and btn.Parent then
            if mobile then
                btn.Position = UDim2.new(0, 10 + (i - 1) * 52, 0.5, -22)
            else
                btn.Position = UDim2.new(0.5, -22, 0, 10 + (i - 1) * 52)
            end
        end
    end
end

task.wait(0.1)
updateResponsiveLayout()

workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    task.wait(0.1)
    updateResponsiveLayout()
end)

applyLanguage()

