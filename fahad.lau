        toggleMobileTP()
    end
end)

--// ✅ تنفيذ النقل عند اللمس (لما الوضع مفعل)
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if not mobileClickTPActive then return end
    if input.UserInputType ~= Enum.UserInputType.Touch then return end

    local mousePos = UserInputService:GetMouseLocation()
    local guiObjects = player.PlayerGui:GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
    local isOverGui = false
    for _, obj in ipairs(guiObjects) do
        if obj:IsDescendantOf(screenGui) then
            isOverGui = true
            break
        end
    end
    if isOverGui then return end

    pcall(function()
        if not rootPart or not character or not character.Parent then return end
        local camera = workspace.CurrentCamera
        if not camera then return end

        local unitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {character}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 5000, raycastParams)
        if not result then return end

        local targetPos = result.Position + Vector3.new(0, 3, 0)
        local cameraLook = camera.CFrame.LookVector
        local flatLook = Vector3.new(cameraLook.X, 0, cameraLook.Z)
        local lookAtPos = targetPos + flatLook

        local newCFrame = CFrame.lookAt(targetPos, lookAtPos)
        character:PivotTo(newCFrame)
    end)
end)

--// SHIFT LOCK
local function enableShiftLock()
    SHIFTLOCK_ENABLED = true
    if humanoid then
        humanoid.CameraOffset = Vector3.new(1.75, 0, 0)
        humanoid.AutoRotate = false
    end
    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        UserInputService.MouseIconEnabled = false
    end)
    shiftCircle.Visible = true

    RunService:UnbindFromRenderStep("FahadMoenShiftLock")
    RunService:BindToRenderStep("FahadMoenShiftLock", Enum.RenderPriority.Camera.Value - 1, function()
        if not SHIFTLOCK_ENABLED then return end
        if not character or not rootPart or not humanoid then return end
        pcall(function()
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
        end)
        local camera = workspace.CurrentCamera
        if not camera then return end
        local cameraLook = camera.CFrame.LookVector
        local flatLook = Vector3.new(cameraLook.X, 0, cameraLook.Z)
        if flatLook.Magnitude > 0.01 then
            flatLook = flatLook.Unit
            local newCFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + flatLook)
            rootPart.CFrame = rootPart.CFrame:Lerp(newCFrame, 0.4)
        end
    end)
end

local function disableShiftLock()
    SHIFTLOCK_ENABLED = false
    RunService:UnbindFromRenderStep("FahadMoenShiftLock")
    if humanoid then
        humanoid.CameraOffset = Vector3.new(0, 0, 0)
        humanoid.AutoRotate = true
    end
    pcall(function()
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end)
    shiftCircle.Visible = false
end

--// JUMP POWER
local function applyJump()
    if humanoid and humanoid.Parent and humanoid.Health > 0 then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = JUMP_POWER
    end
end

local function enableJump()
    JUMP_ENABLED = true
    applyJump()
    if not jumpLoopRunning then
        jumpLoopRunning = true
        task.spawn(function()
            while JUMP_ENABLED do
                if humanoid and humanoid.Parent and humanoid.Health > 0 then
                    humanoid.UseJumpPower = true
                    humanoid.JumpPower = JUMP_POWER
                end
                task.wait(0.15)
            end
            jumpLoopRunning = false
        end)
    end
end

local function disableJump()
    JUMP_ENABLED = false
    if humanoid and humanoid.Parent then
        humanoid.JumpPower = DEFAULT_JUMP
    end
end

local jumpBtn = createToggleButton(featuresPage, "🦘", "jumpPower", "JumpPower", function(updateToggle)
    if JUMP_ENABLED then
        disableJump(); updateToggle(false)
    else
        enableJump(); updateToggle(true)
    end
end)

--// ESP
local function createHighlight(targetChar)
    if not targetChar then return end
    if ESP_HIGHLIGHTS[targetChar] then ESP_HIGHLIGHTS[targetChar]:Destroy(); ESP_HIGHLIGHTS[targetChar] = nil end
    local h = Instance.new("Highlight")
    h.Adornee = targetChar
    h.FillColor = ESP_COLOR
    h.FillTransparency = 0.4
    h.OutlineColor = ESP_COLOR
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = targetChar
    ESP_HIGHLIGHTS[targetChar] = h
end

local function applyESPToPlayer(plr)
    if plr == player then return end
    if plr.Character then createHighlight(plr.Character) end
    plr.CharacterAdded:Connect(function(newChar)
        if ESP_ENABLED then newChar:WaitForChild("Humanoid", 5); task.wait(0.5); createHighlight(newChar) end
    end)
end

local function enableESP()
    ESP_ENABLED = true
    for _, plr in ipairs(Players:GetPlayers()) do applyESPToPlayer(plr) end
    Players.PlayerAdded:Connect(function(plr) if ESP_ENABLED then applyESPToPlayer(plr) end end)
end

local function disableESP()
    ESP_ENABLED = false
    for char, h in pairs(ESP_HIGHLIGHTS) do if h then h:Destroy() end end
    ESP_HIGHLIGHTS = {}
end

local espBtn = createToggleButton(featuresPage, "👁️", "esp", "ESP", function(updateToggle)
    if ESP_ENABLED then
        disableESP(); updateToggle(false)
    else
        enableESP(); updateToggle(true)
    end
end)

